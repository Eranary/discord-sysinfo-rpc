<Window x:Class="DiscordSysInfoRPC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced settings" 
        Width="450" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimary}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Advanced settings" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,20"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="CustomImagesTitle" FontWeight="SemiBold" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CustomImagesHint" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,12"/>
                        
                        <TextBlock x:Name="IdleLabel" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="ImageIdleBox" Margin="0,0,0,8"/>
                        
                        <TextBlock x:Name="LowLabel" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="ImageLowBox" Margin="0,0,0,8"/>
                        
                        <TextBlock x:Name="MediumLabel" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="ImageMediumBox" Margin="0,0,0,8"/>
                        
                        <TextBlock x:Name="HighLabel" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="ImageHighBox"/>
                    </StackPanel>
                </Border>
                
                <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="ThresholdsTitle" FontWeight="SemiBold" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ThresholdsHint" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,12"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock x:Name="ThresholdLowLabel" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="ThresholdLowBox" Text="35"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock x:Name="ThresholdMediumLabel" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="ThresholdMediumBox" Text="65"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock x:Name="ThresholdHighLabel" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="ThresholdHighBox" Text="75"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock x:Name="ThresholdLegend" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ResetBtn" Content="Reset" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" Click="Reset_Click"/>
            <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource PrimaryButton}" Width="100" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
