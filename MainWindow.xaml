<Window x:Class="DiscordSysInfoRPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord SysInfo RPC" 
        Width="500" Height="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgPrimary}"
        Icon="pack://application:,,,/icodiscord.ico">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitle" Grid.Column="0" Text="Discord SysInfo RPC" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="SettingsBtn" Grid.Column="1" Content="⚙" FontSize="18" Width="36" Height="36" 
                        Background="Transparent" Foreground="{StaticResource TextSecondary}" 
                        BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"
                        Click="OpenSettings_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Danger}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                
                <!-- Main Settings -->
                <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="SettingsSectionTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                        
                        <TextBlock x:Name="LabelAppId" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <TextBox x:Name="ClientIdBox" TextChanged="ClientIdBox_TextChanged"/>
                            <TextBlock x:Name="ClientIdPlaceholder" IsHitTestVisible="False"
                                        Foreground="{StaticResource TextMuted}" FontSize="13"
                                        VerticalAlignment="Center" Margin="14,0,12,0"/>
                        </Grid>
                        
                        <TextBlock x:Name="LabelActivityName" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <TextBox x:Name="ActivityNameBox" TextChanged="ActivityNameBox_TextChanged" MaxLength="128"/>
                            <TextBlock x:Name="ActivityNamePlaceholder" IsHitTestVisible="False"
                                        Foreground="{StaticResource TextMuted}" FontSize="13"
                                        VerticalAlignment="Center" Margin="14,0,12,0"/>
                        </Grid>
                        
                        <TextBlock x:Name="LabelActivityType" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ActivityTypeBox" SelectionChanged="ActivityTypeBox_SelectionChanged" Margin="0,0,0,16"/>

                        <TextBlock x:Name="LabelLanguage" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                        <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageBox_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <!-- Additional Options -->
                <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="AdditionalSectionTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                        
                        <TextBlock x:Name="LabelImageSet" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ImageSetBox" Margin="0,0,0,16"/>
                        
                        <StackPanel x:Name="TimerModePanel">
                            <TextBlock x:Name="LabelTimerMode" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox x:Name="TimestampModeBox" Margin="0,0,0,16"/>
                        </StackPanel>
                        <StackPanel x:Name="WatchingDurationPanel" Visibility="Collapsed">
                            <TextBlock x:Name="LabelWatchingDuration" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox x:Name="WatchingDurationBox" SelectionChanged="WatchingDurationBox_SelectionChanged" Margin="0,0,0,12"/>
                            
                            <StackPanel x:Name="WatchingCustomDurationPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <TextBlock x:Name="LabelWatchingCustomDuration" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="WatchingHoursBox" TextAlignment="Center" MaxLength="2"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                                 TextChanged="WatchingHoursBox_TextChanged"
                                                 LostFocus="WatchingTimeBox_LostFocus"/>
                                        <TextBlock x:Name="WatchingHoursPlaceholder" IsHitTestVisible="False"
                                                   Foreground="{StaticResource TextMuted}" FontSize="13"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="LabelWatchingHoursUnit" Grid.Column="1" Text="ч" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                    <Grid Grid.Column="3">
                                        <TextBox x:Name="WatchingMinutesBox" TextAlignment="Center" MaxLength="2"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                                 TextChanged="WatchingMinutesBox_TextChanged"
                                                 LostFocus="WatchingTimeBox_LostFocus"/>
                                        <TextBlock x:Name="WatchingMinutesPlaceholder" IsHitTestVisible="False"
                                                   Foreground="{StaticResource TextMuted}" FontSize="13"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="LabelWatchingMinutesUnit" Grid.Column="4" Text="мин" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="WatchingDurationHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <TextBlock x:Name="LabelUpdateInterval" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6"/>
                        <ComboBox x:Name="UpdateIntervalBox" Margin="0,0,0,16"/>
                        
                        <CheckBox x:Name="AutoConnectBox" IsChecked="True" Margin="0,0,0,16"/>

                        <!-- Process detection & custom text -->
                        <CheckBox x:Name="DetectAppBox" Margin="0,0,0,4" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock x:Name="DetectAppHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox x:Name="UseShortcutNameBox" Margin="0,0,0,4" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock x:Name="UseShortcutNameHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <CheckBox x:Name="CustomStatusTextBox" Margin="0,0,0,4" Checked="CustomStatusText_Changed" Unchecked="CustomStatusText_Changed"/>
                        <TextBlock x:Name="CustomStatusTextHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel x:Name="CustomStatusTextPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock x:Name="LabelCustomDetails" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="CustomDetailsBox" TextChanged="CustomDetailsBox_TextChanged" MaxLength="128"/>
                                <TextBlock x:Name="CustomDetailsPlaceholder" IsHitTestVisible="False"
                                            Foreground="{StaticResource TextMuted}" FontSize="13"
                                            VerticalAlignment="Center" Margin="14,0,12,0"/>
                            </Grid>
                            <TextBlock x:Name="LabelCustomState" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <TextBox x:Name="CustomStateBox" TextChanged="CustomStateBox_TextChanged" MaxLength="128"/>
                                <TextBlock x:Name="CustomStatePlaceholder" IsHitTestVisible="False"
                                            Foreground="{StaticResource TextMuted}" FontSize="13"
                                            VerticalAlignment="Center" Margin="14,0,12,0"/>
                            </Grid>
                            <TextBlock x:Name="CustomStatusTagsHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Buttons in Discord Rich Presence -->
                        <CheckBox x:Name="ShowPromoBox" Margin="0,0,0,4" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock x:Name="ShowPromoHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <CheckBox x:Name="ShowButtonBox" Margin="0,0,0,8" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock x:Name="LabelButtonText" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="ButtonLabelBox" TextChanged="ButtonLabelBox_TextChanged" MaxLength="32"/>
                            <TextBlock x:Name="ButtonLabelPlaceholder" IsHitTestVisible="False"
                                        Foreground="{StaticResource TextMuted}" FontSize="13"
                                        VerticalAlignment="Center" Margin="14,0,12,0"/>
                        </Grid>
                        <TextBlock x:Name="LabelButtonUrl" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <TextBox x:Name="ButtonUrlBox" TextChanged="ButtonUrlBox_TextChanged" MaxLength="512"/>
                            <TextBlock x:Name="ButtonUrlPlaceholder" IsHitTestVisible="False"
                                        Foreground="{StaticResource TextMuted}" FontSize="13"
                                        VerticalAlignment="Center" Margin="14,0,12,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hardware info fold -->
                <Border Background="{StaticResource BgTertiary}" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Padding="16" Cursor="Hand" MouseLeftButtonUp="ToggleSystem">
                            <TextBlock x:Name="SystemToggle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                        <StackPanel x:Name="SystemContent" Visibility="Collapsed" Margin="16,0,16,16">
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                            <ItemsControl x:Name="SystemInfoList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding Value}" Foreground="White" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Help fold -->
                <Border Background="{StaticResource BgSecondary}" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Padding="16" Cursor="Hand" MouseLeftButtonUp="ToggleHelp">
                            <TextBlock x:Name="HelpToggle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                        
                        <StackPanel x:Name="HelpContent" Visibility="Collapsed" Margin="16,0,16,16">
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                            
                            <Border Background="{StaticResource BgTertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="HelpDevPortalTitle" FontWeight="SemiBold" Foreground="White" FontSize="13" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="HelpDevPortal1" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="HelpDevPortal2" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="HelpDevPortal3" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DevPortalLink" Foreground="{StaticResource Accent}" FontSize="12" Cursor="Hand" MouseLeftButtonUp="OpenDevPortal"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Background="{StaticResource BgTertiary}" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock x:Name="HelpServerTitle" FontWeight="SemiBold" Foreground="White" FontSize="13" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="HelpServerHint" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ServerLink" Foreground="{StaticResource Accent}" FontSize="12" Cursor="Hand" MouseLeftButtonUp="OpenServer"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DisconnectBtn" Style="{StaticResource SecondaryButton}" Grid.Column="0" Margin="0,0,5,0" IsEnabled="False" Click="Disconnect_Click"/>
                    <Button x:Name="ConnectBtn" Style="{StaticResource PrimaryButton}" Grid.Column="1" Margin="5,0" Click="Connect_Click"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource SuccessButton}" Grid.Column="2" Margin="5,0,0,0" Click="Save_Click"/>
                </Grid>
                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center">
                    <Run x:Name="FooterPrefixRun" Text="Made with love for Discord "/>
                    <Hyperlink x:Name="DeveloperLink" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource Accent}" TextDecorations="None">
                        <Run x:Name="DeveloperNameRun" Text="@dev"/>
                    </Hyperlink>
                    <Run Text=" &amp; "/>
                    <Hyperlink x:Name="DeveloperLink2" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource Accent}" TextDecorations="None">
                        <Run x:Name="DeveloperName2Run" Text="@dev2"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
